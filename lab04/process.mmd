        Plan --> Dev --> Rev --> Retro --> More
        More -- "Yes" --> Plan
    end

    Harden["Hardening (Week 13)<br/>Role: QA / Build Lead & Developers"]
    Submit(["Final Submission (Week 14)<br/>Role: Product Owner"])

    Req --> Backlog
    Backlog --> Model
Model --> CP1
    CP1 -- "Approved" --> Plan
    Rev -. "Feedback" .-> Backlog
